{
  "name": "pyroscope-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Grafana Pyroscope",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pyroscope-mcp": "dist/index.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "pyroscope",
    "profiling"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
